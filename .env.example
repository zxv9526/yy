# ==============================================================================
# 🀄 国粹棋牌全功能服务 - 环境变量配置文件 (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 公网访问域名 (用于自动配置 Telegram Webhook 或轮询启动)
# ------------------------------------------------------------------------------
# 💡 【核心调度机制】：
# • 方案 A (自动 Webhook)：若配置了有效的公网 HTTPS 域名 (例如 Cloudflare Tunnel、frp、已备案域名等):
#   服务启动时会自动调用 Telegram 官方 setWebhook 注册: ${URL}/api/telegram/webhook
#   Telegram 官方收到用户消息后将毫秒级直推至本服务！
#   示例: URL="https://chess-game.trycloudflare.com"
#
# • 方案 B (自动长轮询 Polling)：若留空或未设置 URL (例如 URL="" 或注释掉):
#   服务将自动降级为【长轮询模式 (Long Polling)】启动 Bot！
#   优势：【完全无需公网 IP、无需域名、无需端口映射、无需证书】，在 Termux 手机内网即可秒收 Bot 指令！
URL=""

# 兼容别名 (同 URL)
APP_URL=""

# 强制模式 (可选: auto | webhook | polling，默认 auto 根据 URL 是否为 HTTPS 自动切换)
BOT_MODE="auto"

# ------------------------------------------------------------------------------
# 2. Telegram Bot 机器人 Token
# ------------------------------------------------------------------------------
# 在 Telegram 搜索 @BotFather 发送 /newbot 创建机器人获取到的 Token
# 示例: TELEGRAM_BOT_TOKEN="7123456789:AAHxyzABCDEFGHIJKLMNopqrstuvwxyz"
TELEGRAM_BOT_TOKEN=""

# ------------------------------------------------------------------------------
# 3. 管理员 Telegram 用户名 (无需 @ 符号，多个用逗号隔开)
# ------------------------------------------------------------------------------
# 提示: 茶客手机号白名单直接在 Telegram Bot 中向 Bot 发送手机号进行秒级实时白名单授权，无需在环境变量中维护手机号
# 示例: ADMIN_USERNAMES="my_tg_username,boss_account"
ADMIN_USERNAMES="admin_username"

# ------------------------------------------------------------------------------
# 4. Telegram Webhook 密钥安全令牌 (可选)
# ------------------------------------------------------------------------------
# Telegram 官方推送时将在 HTTP 请求头附带 X-Telegram-Bot-Api-Secret-Token 进行防伪校验
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 5. 服务运行端口与主机绑定
# ------------------------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"
