# ==============================================================================
# 🀄 国粹棋牌全功能服务 - 环境变量配置文件 (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram API 反代端点 / API 地址 (核心：国内免翻墙连接 Telegram)
# ------------------------------------------------------------------------------
# 💡 【国内免翻墙直连说明】：
# 国内 Termux 或国内服务器直连 api.telegram.org 会被网络阻断 (报错 TypeError: fetch failed)。
# 在此处填写反代 Telegram 的 URL (如 Cloudflare Worker 反代、Nginx 反代或三方 TG API 域名):
# 示例: URL="https://tg.your-domain.workers.dev" 或 URL="https://api.telegram-proxy.com"
# 系统会自动通过该反代收发 Bot 指令，免挂 VPN / 代理！
# 也可通过 TELEGRAM_API_BASE 或 TG_PROXY 变量指定。
URL=""
TELEGRAM_API_BASE=""

# ------------------------------------------------------------------------------
# 2. Telegram Bot 机器人 Token
# ------------------------------------------------------------------------------
# 在 Telegram 搜索 @BotFather 发送 /newbot 创建机器人获取到的 Token
# 示例: TELEGRAM_BOT_TOKEN="7123456789:AAHxyzABCDEFGHIJKLMNopqrstuvwxyz"
TELEGRAM_BOT_TOKEN=""

# ------------------------------------------------------------------------------
# 3. 管理员 Telegram 用户名 (无需 @ 符号，多个用逗号隔开)
# ------------------------------------------------------------------------------
# 提示: 茶客手机号白名单直接在 Telegram Bot 中向 Bot 发送手机号进行秒级实时白名单授权，无需在环境变量中维护手机号
# 示例: ADMIN_USERNAMES="my_tg_username,boss_account"
ADMIN_USERNAMES="admin_username"

# ------------------------------------------------------------------------------
# 4. 运行模式与可选的 Webhook 穿透域名 (可选)
# ------------------------------------------------------------------------------
# • 默认模式: auto / polling (自动长轮询模式，无需隧道与公网域名，通过反代直接收发！)
# • 若需使用 Webhook 模式: 填写 WEBHOOK_URL="https://your-game.trycloudflare.com" 并设 BOT_MODE="webhook"
BOT_MODE="auto"
WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 5. 服务运行端口与主机绑定
# ------------------------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"
